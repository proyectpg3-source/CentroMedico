import { useEffect, useState } from "react";
import {
  User,
  AlertCircle,
  ClipboardList,
  Stethoscope,
  Pill,
  FlaskConical,
  Save,
  ArrowLeft,
  Loader2,
  Activity,
  History,
  Warning,
  Printer
} from "lucide-react";
import { Header } from "../components/layout/Header";
import { request } from "../api/client";
import { formatDateTime } from "../lib/format";
import PrescriptionPrint from "./PrescriptionPrint";

interface ClinicalHistory {
  patient: any;
  currentTriage: any;
  history: {
    triages: any[];
    visits: any[];
    prescriptions: any[];
    labs: any[];
  };
  alerts: {
    hasAllergies: boolean;
    allergies: string;
  };
}

export default function MedicalConsultation({ appointmentId }: { appointmentId: string }) {
  const [history, setHistory] = useState<ClinicalHistory | null>(null);
  const [loading, setLoading] = useState(true);
  const [visitForm, setVisitForm] = useState({
    impresion_clinica: "",
    diagnostico: "",
    tratamiento: "",
    conducta: "",
    examen_fisico: "",
  });
  const [saving, setSaving] = useState(false);
  const [printPrescription, setPrintPrescription] = useState(false);

  useEffect(() => {
    async function loadPatientData() {
      try {
        const appointment = await request<any>(`/api/citas/${appointmentId}`);
        const fullHistory = await request<ClinicalHistory>(`/api/visitas/historial/${appointment.id_paciente}`);
        setHistory(fullHistory);
      } catch (error) {
        console.error("Error loading clinical history:", error);
      } finally {
        setLoading(false);
      }
    }
    loadPatientData();
  }, [appointmentId]);

  async function handleSaveVisit() {
    setSaving(true);
    try {
      await request("/api/visitas", {
        method: "POST",
        body: JSON.stringify({
          id_cita: appointmentId,
          ...visitForm,
          id_paciente: history?.patient.id_paciente,
          id_medico: history?.patient.id_medico,
          fecha_visita: new Date().toISOString(),
        })
      });
      alert("Consulta guardada exitosamente");
    } catch (error) {
      alert("Error al guardar la consulta");
    } finally {
      setSaving(false);
    }
  }

  if (loading) return (
    <div className="flex h-screen items-center justify-center">
      <Loader2 className="h-8 w-8 animate-spin text-blue-600" />
    </div>
  );

  if (!history) return <div className="p-8 text-center">No se encontró información del paciente.</div>;

  return (
    <div className="flex min-h-screen flex-col bg-slate-50">
      <Header
        title={`Consulta: ${history.patient.nombre}`}
        subtitle={`Paciente ID: ${history.patient.id_paciente} · ${history.patient.sexo} · ${history.patient.fecha_nacimiento}`}
      />

      {printPrescription ? (
        <div className="p-6">
          <button
            onClick={() => setPrintPrescription(false)}
            className="mb-4 flex items-center gap-2 rounded-lg bg-slate-200 px-4 py-2 text-sm font-medium hover:bg-slate-300 transition-colors"
          >
            <ArrowLeft className="h-4 w-4" /> Volver a la Consulta
          </button>
          <div className="mx-auto max-w-4xl bg-white shadow-2xl rounded-lg overflow-hidden">
            <PrescriptionPrint
              patient={history.patient}
              doctor={{ nombre: "Dr. Médico Especialista", especialidad: "Medicina General" }}
              prescription={{
                medicamento: visitForm.tratamiento || "Sin medicamento",
                dosis: "Ver indicaciones",
                frecuencia: "Según prescripción",
                duracion: "7 días",
                instrucciones: "Siga las instrucciones del médico estrictamente."
              }}
              date={new Date().toLocaleDateString()}
            />
            <div className="p-4 bg-slate-100 flex justify-center no-print">
              <button
                onClick={() => window.print()}
                className="flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2 text-sm font-semibold text-white hover:bg-blue-700 shadow-md transition-all"
              >
                <Printer className="h-4 w-4" /> Imprimir Receta Profesional
              </button>
            </div>
          </div>
        </div>
      ) : (
        <div className="flex-1 p-4 lg:p-6">
          <div className="grid grid-cols-1 gap-6 xl:grid-cols-12">

            {/* COLUMNA IZQUIERDA: HISTORIAL Y ALERTAS (3/12) */}
            <div className="space-y-6 xl:col-span-3">
              {history.alerts.hasAllergies && (
                <div className="rounded-2xl border-2 border-rose-500 bg-rose-50 p-4 text-rose-800 shadow-sm">
                  <div className="flex items-center gap-2 font-bold uppercase text-xs mb-2">
                    <Warning className="h-4 w-4" />
                    Alergias Detectadas
                  </div>
                  <p className="text-sm leading-relaxed">{history.alerts.allergies}</p>
                </div>
              )}

              <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div className="mb-3 flex items-center gap-2 text-slate-900 font-semibold text-sm">
                  <Activity className="h-4 w-4 text-blue-600" />
                  Triaje Actual
                </div>
                <div className="grid grid-cols-2 gap-3 text-xs">
                  <div className="p-2 rounded bg-slate-50 border border-slate-100">
                    <span className="text-slate-500 block">P/A</span>
                    <span className="font-bold">{history.currentTriage?.presion_arterial || "---"}</span>
                  </div>
                  <div className="p-2 rounded bg-slate-50 border border-slate-100">
                    <span className="text-slate-500 block">FC</span>
                    <span className="font-bold">{history.currentTriage?.frecuencia_cardiaca || "---"} lpm</span>
                  </div>
                  <div className="p-2 rounded bg-slate-50 border border-slate-100">
                    <span className="text-slate-500 block">Temp</span>
                    <span className="font-bold">{history.currentTriage?.temperatura || "---"} °C</span>
                  </div>
                  <div className="p-2 rounded bg-slate-50 border border-slate-100">
                    <span className="text-slate-500 block">SpO2</span>
                    <span className="font-bold">{history.currentTriage?.saturacion_oxigeno || "---"} %</span>
                  </div>
                </div>
              </div>

              <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
                <div className="mb-3 flex items-center gap-2 text-slate-900 font-semibold text-sm">
                  <History className="h-4 w-4 text-blue-600" />
                  Historial Reciente
                </div>
                <div className="space-y-4">
                  {history.history.visits.map((visit, i) => (
                    <div key={i} className="border-l-2 border-slate-100 pl-3 py-1">
                      <p className="text-[10px] font-bold text-slate-400">{formatDateTime(visit.fecha_visita)}</p>
                      <p className="text-xs font-medium text-slate-700">{visit.diagnostico}</p>
                    </div>
                  ))}
                  {history.history.visits.length === 0 && <p className="text-xs text-slate-400 italic">Sin visitas previas.</p>}
                </div>
              </div>
            </div>

            {/* COLUMNA CENTRAL: ATENCIÓN ACTUAL (6/12) */}
            <div className="xl:col-span-6 space-y-6">
              <div className="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                <div className="mb-6 flex items-center justify-between">
                  <h2 className="text-lg font-semibold text-slate-900 flex items-center gap-2">
                    <Stethoscope className="h-5 w-5 text-blue-600" />
                    Evaluación Médica
                  </h2>
                  <div className="text-xs text-slate-500">Fecha: {new Date().toLocaleDateString()}</div>
                </div>

                <div className="space-y-5">
                  <div>
                    <label className="text-sm font-medium text-slate-700">Examen Físico</label>
                    <textarea
                      rows={4}
                      value={visitForm.examen_fisico}
                      onChange={e => setVisitForm({...visitForm, examen_fisico: e.target.value})}
                      className="mt-1.5 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                      placeholder="Descripción del estado físico actual..."
                    />
                  </div>

                  <div>
                    <label className="text-sm font-medium text-slate-700">Impresión Clínica</label>
                    <textarea
                      rows={3}
                      value={visitForm.impresion_clinica}
                      onChange={e => setVisitForm({...visitForm, impresion_clinica: e.target.value})}
                      className="mt-1.5 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                      placeholder="Análisis preliminar del caso..."
                    />
                  </div>

                  <div className="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                      <label className="text-sm font-medium text-slate-700">Diagnóstico Final *</label>
                      <input
                        required
                        value={visitForm.diagnostico}
                        onChange={e => setVisitForm({...visitForm, diagnostico: e.target.value})}
                        className="mt-1.5 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                        placeholder="Ej: Hipertensión Arterial"
                      />
                    </div>
                    <div>
                      <label className="text-sm font-medium text-slate-700">Conducta / Plan</label>
                      <input
                        value={visitForm.conducta}
                        onChange={e => setVisitForm({...visitForm, conducta: e.target.value})}
                        className="mt-1.5 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                        placeholder="Ej: Reposo, dieta hiposódica"
                      />
                    </div>
                  </div>

                  <div>
                    <label className="text-sm font-medium text-slate-700">Tratamiento / Medicación</label>
                    <textarea
                      rows={3}
                      value={visitForm.tratamiento}
                      onChange={e => setVisitForm({...visitForm, tratamiento: e.target.value})}
                      className="mt-1.5 w-full rounded-xl border border-slate-200 p-3 text-sm outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                      placeholder="Medicamentos, dosis y frecuencia..."
                    />
                  </div>
                </div>

                <div className="mt-8 flex justify-end gap-3">
                  <button
                    onClick={() => setPrintPrescription(true)}
                    disabled={!visitForm.tratamiento}
                    className="flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50 transition-all shadow-sm disabled:opacity-50"
                  >
                    <Printer className="h-4 w-4" /> Previsualizar Receta
                  </button>
                  <button
                    onClick={handleSaveVisit}
                    disabled={saving || !visitForm.diagnostico}
                    className="flex items-center gap-2 rounded-xl bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white hover:bg-blue-700 disabled:opacity-50 transition-all shadow-md"
                  >
                    {saving ? <Loader2 className="h-4 w-4 animate-spin" /> : <Save className="h-4 w-4" />}
                    Finalizar y Guardar Consulta
                  </button>
                </div>
              </div>
            </div>
          </div>

          {/* COLUMNA DERECHA: RECETAS Y EXÁMENES (3/12) */}
          <div className="space-y-6 xl:col-span-3">
            <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <div className="mb-3 flex items-center gap-2 text-slate-900 font-semibold text-sm">
                <Pill className="h-4 w-4 text-emerald-600" />
                Medicaciones Recientes
              </div>
              <div className="space-y-3">
                {history.history.prescriptions.map((p, i) => (
                  <div key={i} className="p-2 rounded bg-slate-50 border border-slate-100 text-xs">
                    <p className="font-bold text-slate-800">{p.medicamento}</p>
                    <p className="text-slate-500">{p.dosis} - {p.frecuencia}</p>
                    <p className="text-[10px] text-slate-400 mt-1">{formatDateTime(p.fecha_visita)}</p>
                  </div>
                ))}
                {history.history.prescriptions.length === 0 && <p className="text-xs text-slate-400 italic">Sin prescripciones previas.</p>}
              </div>
            </div>

            <div className="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
              <div className="mb-3 flex items-center gap-2 text-slate-900 font-semibold text-sm">
                <FlaskConical className="h-4 w-4 text-purple-600" />
                Laboratorios
              </div>
              <div className="space-y-3">
                {history.history.labs.map((l, i) => (
                  <div key={i} className="p-2 rounded bg-slate-50 border border-slate-100 text-xs">
                    <div className="flex justify-between items-start mb-1">
                      <p className="font-bold text-slate-800">{l.examen}</p>
                      <span className={`px-1.5 py-0.5 rounded-full text-[9px] ${l.estado === 'completado' ? 'bg-emerald-100 text-emerald-700' : 'bg-amber-100 text-amber-700'}`}>
                        {l.estado}
                      </span>
                    </div>
                    {l.resultado ? (
                      <p className="text-slate-600 italic">"{l.resultado}"</p>
                    ) : (
                      <p className="text-slate-400 italic">Pendiente de resultado</p>
                    )}
                    <p className="text-[10px] text-slate-400 mt-1">{formatDateTime(l.created_at)}</p>
                  </div>
                ))}
                {history.history.labs.length === 0 && <p className="text-xs text-slate-400 italic">Sin órdenes de laboratorio.</p>}
              </div>
            </div>
          </div>

        </div>
      </div>
    )
  );
}
