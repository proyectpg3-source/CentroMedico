# Base de datos PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=Centro_medico
DB_PASSWORD=
DB_PORT=5432

# Servidor
PORT=5000

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Generar con npm run secret:generate
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Microservicios
TRIAGE_SERVICE_URL=http://localhost:4101
INVENTORY_ALERTS_SERVICE_URL=http://localhost:4102
MICROSERVICE_TIMEOUT_MS=1500
INVENTORY_EXPIRING_SOON_DAYS=180
