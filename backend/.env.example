# Base de datos PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=Centro_medico
DB_PASSWORD=
DB_PORT=5432

# Servidor
PORT=5000

# CORS - Orígenes permitidos (separados por coma)
CORS_ORIGIN=http://localhost:5173

# Generar con npm run secret:generate
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Alertas calculadas dentro del backend
INVENTORY_EXPIRING_SOON_DAYS=180

# Correo real con Resend: activar solo después de verificar el remitente.
EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
# URLs públicas HTTPS sin barra final. APP_URL es el frontend; PUBLIC_API_URL el backend.
APP_URL=
PUBLIC_API_URL=
